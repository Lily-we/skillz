# Copy this file to .env and fill in your real key.
# .env is gitignored — it will never be committed or pushed.

GEMINI_API_KEY=your-key-here
DJANGO_SECRET_KEY=generate-a-real-one-for-anything-beyond-local-demo

# Optional — override if Google renames/deprecates the default model again.
# Current default: gemini-3.6-flash
# GEMINI_MODEL=gemini-3.6-flash
